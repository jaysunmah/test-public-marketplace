{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "test-public-marketplace",
  "description": "Public test marketplace for development and testing of Claude Code plugins",
  "owner": {
    "name": "jaysunmah",
    "email": "test@example.com"
  },
  "plugins": [
    {
      "name": "test-lsp-plugin",
      "description": "Test LSP plugin for TypeScript/JavaScript language server",
      "version": "1.0.0",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/test-lsp-plugin",
      "category": "development",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact"
          }
        }
      }
    },
    {
      "name": "example-plugin",
      "description": "A comprehensive example plugin demonstrating all Claude Code extension options",
